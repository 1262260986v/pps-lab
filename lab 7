Q. Write a c program to store and process experimental data for 'n' bioengineering samples.  Accept the sample ID, sample type,initial mass,final mass after processing 
Calculate the percentage mass change for each sample and display complete details of all samples (hydrogen,biomass,biopolymer,bacteria)

#include<stdio.h>
struct Sample
{ 
  int sampleID;
  char sampleType[30];
  float initialMass;
  float finalMass;
  float percentageChange;
    };
  
  int main()
  {
    struct Sample s[100];
    int n, i;
    printf("enter number of samples: ");
    scanf("%d", &n);
    for (i=0; i < n; i++)
    {
    
      printf("\nEnter details of sample %d\n", i+1);
  
      printf("Enter sample ID: ");
      scanf("%d", &s[i].sampleID);
      printf("enter sample type: ");
      scanf("%29s", s[i].sampleType);
      printf("enter initial mass: ");
      scanf("%f", &s[i].initialMass);
      printf("enter final mass: ");
      scanf("%f", &s[i].finalMass);
      
      s[i].percentageChange =   ((s[i].finalMass - s[i].initialMass)
          /s[i].initialMass) * 100;
          
      }
      printf("\n--- bioengineering sample report---\n");
      for (i = 0; i < n; i++) 
      {
        printf("\nsample ID: %d", s[i].sampleID);
        printf("\nsample type: %s", s[i].sampleType);
        printf("\ninitial mass: %.2f" , s[i].initialMass);
        printf("\nfinalMass: %.2f", s[i].finalMass);
        printf("\npercentage Mass change: %.2f%%\n",
               s[i].percentageChange);
               
      }
       return 0;
       }
