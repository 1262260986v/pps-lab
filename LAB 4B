Q. A bioengineer lab recorded 2 sets of measurements data from biologicalsamples in the form of 2 by 2 matrix , write a C programm to add 2 matrices by adding for corresponding elements and display resultant matrix


#include <stdio.h>
int main()
{
 
   int A[2][2],B[2][2],C[2][2];
   int i,j;
     
     
  //input first matrix
  printf("Enter the measurements for first biological sample:\n");
  for(i =0;i<2;i++)
  {
   
    for(j=0;j<2;j++)
    {
       scanf("%d",&A[i][j]);
    }
 }
     
     
    //input second matrix
    printf("enter the measurements for second biological sample:\n");
    for(i=0;i<2;i++)
    {
      for(j=0;j<2;j++)
      {
         scanf("%d",&B[i][j]);
         }
      }
     
     
    //Add the two matrices
    for(i=0;i<2;i++)
    {
      for(j=0;j<2;j++)
      {
        C[i][j]=A[i][j]+B[i][j];
      }
    }
   
    //display resultant matrix
    printf("\nResultant measurment matrix:\n");
   
    for(i=0;i<2;i++)
    {
       for(j=0;j<2;j++)
       {
       printf("%d\t",C[i][j]);
       }
       printf("\n");
       }
       
       return 0;
     }
