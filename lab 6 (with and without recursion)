// Q.write a c program to compute factorial with and without recursion 

// without recursion

#include <stdio.h>
int fact_rec(int num);  // Function declaration
int main()
{
    int num;
    int result;
    printf("Enter the number : ");
    scanf("%d", &num);
    result = fact_rec(num);  // Function call
    printf("Result =%d \n", result);

    return 0;
}

int fact_rec(int num)  // Function definition
{
    if(num == 1)
        return 1;
    else

        return num * fact_rec(num - 1);
}

// with recursion 

#include <stdio.h>
int factorial(int n)
{
   int i;
   int fact = 1;
       for (i = 1; i <= n; i++)
   {
       fact = fact * i;     }
   return fact;
}
 
int main()
{
   int num = 5;
   int result;
   result = factorial(num);
   printf("Factorial of %d=%d\n", num, result);
   return 0;
}

